##
## castle-boost.soar
## Elaboration rules that annotate retrieved memories with boost-tags.
##
## Input-link structure (pushed by soar_bridge.py):
##   state ^io.input-link <il>
##   <il>  ^context <ctx>
##         ^memory  <m>           (one per retrieved memory)
##   <ctx> ^project "ru-sixth-sense"
##         ^query   "try scored corner"
##   <m>   ^id               "abc-123"
##         ^type             "semantic"
##         ^subtype          "correction"
##         ^project          "ru-sixth-sense"
##         ^score            0.85
##         ^decay            1.0
##         ^access-count     7
##         ^recently-accessed "true"
##
## Each matching production adds a ^boost-tag attribute to <m>.
## The Python bridge maps tags → numeric multipliers and applies them.
##

## ── Rule 1: correction in the same project ─────────────────────────────────
## A recorded correction is the highest-value memory for future tasks in the
## same project. It prevents repeating a known mistake.
sp {castle*elaborate*correction-same-project
   "Correction memory from the current project: very high priority."
   (state <s> ^io.input-link <il>)
   (<il> ^context.project <proj>
         ^memory <m>)
   (<m> ^subtype |correction|
        ^project <proj>)
-->
   (<m> ^boost-tag |correction-same-project|)
}

## ── Rule 2: any procedural (how-to) memory ────────────────────────────────
## Procedural memories contain step-by-step operations. They should always
## rank high because they encode executable knowledge.
sp {castle*elaborate*procedural-boost
   "Procedural memories contain executable steps — always prioritise."
   (state <s> ^io.input-link.memory <m>)
   (<m> ^type |procedural|)
-->
   (<m> ^boost-tag |procedural|)
}

## ── Rule 3: deployment procedure memory ───────────────────────────────────
## Deployment facts are operationally critical — a mistake causes incidents.
sp {castle*elaborate*deployment-boost
   "Deployment memories carry operational risk — keep them prominent."
   (state <s> ^io.input-link.memory <m>)
   (<m> ^subtype |deployment|)
-->
   (<m> ^boost-tag |deployment|)
}

## ── Rule 4: user preference memory ────────────────────────────────────────
## User preferences (communication style, tool choices) shape every response.
sp {castle*elaborate*user-preference-boost
   "User preference memories personalise every output."
   (state <s> ^io.input-link.memory <m>)
   (<m> ^type |user|)
-->
   (<m> ^boost-tag |user-preference|)
}

## ── Rule 5: accessed within the last 24 hours ─────────────────────────────
## Recent access signals the memory is still live in the working context.
sp {castle*elaborate*recent-access-boost
   "Memory accessed in the last 24 h is likely still relevant."
   (state <s> ^io.input-link.memory <m>)
   (<m> ^recently-accessed |true|)
-->
   (<m> ^boost-tag |recent-access|)
}

## ── Rule 6: proven durable — high access count ────────────────────────────
## A memory retrieved 5+ times has repeatedly proved useful.
sp {castle*elaborate*high-access-boost
   "Memory with 5+ retrievals has proven durable value."
   (state <s> ^io.input-link.memory <m>)
   (<m> ^access-count {> 4})
-->
   (<m> ^boost-tag |high-access|)
}

## ── Rule 7: architectural decision ────────────────────────────────────────
## Architecture decisions constrain later work; missing one causes conflict.
sp {castle*elaborate*architecture-boost
   "Architecture decisions constrain future implementation choices."
   (state <s> ^io.input-link.memory <m>)
   (<m> ^subtype |architecture|)
-->
   (<m> ^boost-tag |architecture|)
}

## ── Rule 8: stale memory — low decay, not a protected type ────────────────
## A memory with very low decay score that is neither procedural nor a user
## preference has been forgotten by the system and should rank lower.
sp {castle*elaborate*stale-penalty
   "Memory with low decay score that is not protected should rank lower."
   (state <s> ^io.input-link.memory <m>)
   (<m> ^decay {< 0.3})
   -(<m> ^type |procedural|)
   -(<m> ^type |user|)
-->
   (<m> ^boost-tag |stale|)
}

## ── Rule 9: cross-project memory (lower priority) ─────────────────────────
## A memory from a different project may still be relevant but is less certain.
sp {castle*elaborate*cross-project-penalty
   "Memory from a different project is less certain to apply here."
   (state <s> ^io.input-link <il>)
   (<il> ^context.project <current-proj>
         ^memory <m>)
   (<m> ^project {<mem-proj> <> <current-proj>}
        ^project {<> ||})
-->
   (<m> ^boost-tag |cross-project|)
}

## ── Reporting rule ──────────────────────────────────────────────────────────
## For every memory that received any boost-tag, write a ^boost WME onto the
## output-link so the Python bridge can read it.  One rule fires for each
## (memory, tag) pair — multiple tags on one memory produce multiple WMEs.
##
## Using an elaboration rule (i-supported) rather than an operator apply so
## the report fires in the same elaboration phase as the boost rules and the
## Python bridge always sees results regardless of operator selection.
sp {castle*elaborate*report-boost
   "Propagate each memory's boost-tag to the output-link for the Python bridge."
   (state <s> ^io <io>)
   (<io> ^input-link.memory <m>
         ^output-link <ol>)
   (<m> ^boost-tag <tag>
        ^id <id>)
-->
   (<ol> ^boost <b>)
   (<b> ^memory-id <id>
        ^tag <tag>)
}
